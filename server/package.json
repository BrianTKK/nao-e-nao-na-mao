{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API, WebSocket e web compilada do Mariana, na mesma origem.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=.env src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "migrate": "tsx --env-file-if-exists=.env src/cli.ts migrate",
    "seed": "tsx --env-file-if-exists=.env src/cli.ts seed",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "demo:reset": "tsx --env-file-if-exists=.env src/cli.ts demo:reset",
    "push:test": "tsx --env-file-if-exists=.env scripts/push-test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@nenm/shared": "*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
