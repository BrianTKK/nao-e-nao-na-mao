# Copie para server/.env (no PC) ou para o .env do compose (na VPS). Nunca commite o .env.
NODE_ENV=development
PORT=8080
# Postgres da VPS (no compose: postgres://naoenao:<senha>@db:5432/naoenao).
# Sem DATABASE_URL, o servidor usa o Postgres embutido em server/.data (só desenvolvimento).
# DATABASE_URL=
# Segredo dos tokens de login: 32+ caracteres aleatórios (obrigatório em produção).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=
SESSION_HOURS=16
# Origens extras que podem chamar a API (o Expo web em desenvolvimento).
CORS_ORIGINS=http://localhost:8081
# 1 = cria o bar fictício e as contas de teste se o banco estiver vazio.
SEED_DEMO=1
# Atrás do Nginx da VPS: 1.
TRUST_PROXY=0
