# .env do compose na VPS (/var/www/naoenao/.env). Nunca vai para o git.
# Porta local do app (o Nginx aponta para ela). Em produção: 3070 (a 3060 é da Central Pessoal).
APP_PORT=3070
# Senha do Postgres do compose (aleatória, 32+ caracteres).
POSTGRES_PASSWORD=
# Segredo dos tokens de login (aleatório, 32+ caracteres):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Validade do login da equipe, em horas.
SESSION_HOURS=16
# 1 = cria o bar de demonstração no primeiro início.
SEED_DEMO=1
# Origens extras que podem chamar a API de outro domínio (normalmente vazio:
# a web está na mesma origem e o app no celular não envia Origin).
CORS_ORIGINS=
