# Copie para .env.
# mock = dados simulados; api = o servidor (server/), a partir da F1.
EXPO_PUBLIC_DATA_SOURCE=mock
# URL pública do servidor: assim o Expo Go funciona de qualquer lugar.
# Em desenvolvimento, use o IP do PC na rede (ex.: http://192.168.0.10:8080).
EXPO_PUBLIC_API_URL=https://naoenao.obrian.me
